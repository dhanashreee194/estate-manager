generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= COMPANY (TENANT)
model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  projects  Project[]
  materials Material[]
  Customer  Customer[]
  Unit      Unit[]
  Booking   Booking[]
  Payment   Payment[]
  labours   Labour[]
  buildings Building[]
  wings     Wing[]
  leads     Lead[]
  vendors   Vendor[]
  bankAccounts BankAccount[]
  cashbookEntries CashbookEntry[]
  brokers   Broker[]
  landPartners LandPartner[]
  landParcels  LandParcel[]
  reminders    Reminder[]
  marketingCampaigns MarketingCampaign[]
}

enum VendorType {
  LABOUR
  MATERIAL
  BOTH
}

// ================= VENDORS (labour contractors / material suppliers)
model Vendor {
  id        String     @id @default(uuid())
  companyId String
  name      String
  phone     String?
  email     String?
  gstNumber String?
  address   String?
  type      VendorType @default(BOTH)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  company          Company           @relation(fields: [companyId], references: [id])
  labours          Labour[]
  inventoryInwards InventoryInward[]
  expenses         Expense[]
  dailyLabours     DailyLabour[]
  dailyPayments    DailyPayment[]
  dailyGoods       DailyGoods[]

  @@index([companyId])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  SALES
  ACCOUNTANT
}

// ================= USERS
model User {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  password  String
  role      String
  companyId String

  company  Company   @relation(fields: [companyId], references: [id])
  leads    Lead[]    @relation("UserLeads")
  bookings Booking[] @relation("UserBookings") // ✅ correct
  marketingCampaigns MarketingCampaign[] @relation("UserCampaigns")
}

// ================= PROJECTS / SITES
model Project {
  id        String   @id @default(uuid())
  name      String
  location  String?
  status    String
  createdAt DateTime @default(now())
  companyId String

  // Site layout map grid (Easy Colonizer–style)
  layoutRows     Int     @default(10)
  layoutCols     Int     @default(10)
  layoutImageUrl String?

  company           Company                @relation(fields: [companyId], references: [id])
  inventories       Inventory[]
  inventoryInwards  InventoryInward[]
  inventoryOutwards InventoryOutward[]
  expenses          Expense[]
  labours           LabourAssignment[]
  attendance        LabourAttendance[]
  Building          Building[]
  Unit              Unit[]
  Booking           Booking[]
  requirements      InventoryRequirement[]
  dailyReports      DailyReport[]
  tasks             Task[]
  budget            ProjectBudget?
  leads             Lead[]
  cashbookEntries   CashbookEntry[]
  landParcels       LandParcel[]
  marketingCampaigns MarketingCampaign[]
}

// ================= MATERIALS (COMPANY-SCOPED)
enum MaterialUnit {
  BAG
  KG
  TON
  PIECE
  LITER
  BRASS
}

model Material {
  id        String       @id @default(uuid())
  name      String
  unit      MaterialUnit
  unitCost  Float
  companyId String

  company           Company                @relation(fields: [companyId], references: [id])
  inventories       Inventory[]
  inventoryInwards  InventoryInward[]
  inventoryOutwards InventoryOutward[]
  requirements      InventoryRequirement[]
}

// ================= INVENTORY
model Inventory {
  id         String @id @default(uuid())
  projectId  String
  materialId String
  quantity   Float

  project  Project   @relation(fields: [projectId], references: [id])
  material Material  @relation(fields: [materialId], references: [id])
  expenses Expense[]

  @@unique([projectId, materialId])
}

// ================= LABOUR
model Labour {
  id        String @id @default(uuid())
  name      String
  category  String
  dailyWage Int

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Labour supplied through a vendor/contractor
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  assignments LabourAssignment[]
  attendances LabourAttendance[]

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// ================= EXPENSES (SINGLE LEDGER)
model Expense {
  id        String   @id @default(uuid())
  projectId String
  type      String
  amount    Float
  date      DateTime
  description String?
  gstRate   Float? // 5, 12, 18, 28
  gstAmount Float?
  vendorGST String?

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  project          Project           @relation(fields: [projectId], references: [id])
  LabourAttendance LabourAttendance?
  cashbookEntry    CashbookEntry?

  @@index([vendorId])
  @@index([bankAccountId])
}

// ================= LABOUR ASSIGNMENT
model LabourAssignment {
  id        String    @id @default(uuid())
  labourId  String
  projectId String
  startDate DateTime  @default(now())
  endDate   DateTime?

  labour  Labour  @relation(fields: [labourId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

// ================= LABOUR ATTENDANCE
model LabourAttendance {
  id         String   @id @default(uuid())
  labourId   String
  projectId  String
  date       DateTime
  present    Boolean
  wageForDay Float

  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  labour  Labour  @relation(fields: [labourId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([labourId, projectId, date])
}

enum UnitType {
  PLOT
  FLAT
  ROW_HOUSE
  VILLA
}

enum UnitStatus {
  AVAILABLE
  HOLD
  BOOKED
  SOLD
  CANCELLED
}

enum BookingStatus {
  HOLD
  BOOKED
  PARTIAL_PAID
  FULLY_PAID
  REGISTERED
  CANCELLED
}

enum PaymentMode {
  CASH
  CHEQUE
  ONLINE
}

model Building {
  id        String  @id @default(uuid())
  projectId String
  name      String
  facing    String?

  project   Project  @relation(fields: [projectId], references: [id])
  wings     Wing[]
  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Wing {
  id            String  @id @default(uuid())
  buildingId    String
  name          String
  totalFloors   Int
  hasLift       Boolean
  liftsCount    Int?
  flatsPerFloor Int?

  building  Building @relation(fields: [buildingId], references: [id])
  flats     Unit[]
  Company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Unit {
  id        String   @id @default(uuid())
  projectId String
  companyId String
  unitType  UnitType

  wingId     String?
  unitNumber String
  areaSqFt   Float
  direction  String?
  floor      Int?
  bhkType    String?
  basePrice  Float
  status     UnitStatus @default(AVAILABLE)

  // Position on project layout map (0-based grid)
  layoutRow Int?
  layoutCol Int?

  project Project @relation(fields: [projectId], references: [id])
  wing    Wing?   @relation(fields: [wingId], references: [id])
  Company Company @relation(fields: [companyId], references: [id])

  Booking Booking? // ✅ One unit → one booking
  leads   Lead[]
  marketingCampaigns MarketingCampaign[]

  @@index([projectId, layoutRow, layoutCol])
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  name      String
  phone     String
  email     String?
  address   String?

  // ✅ NEW
  panNumber     String?
  aadharNumber  String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  bookings  Booking[]
  documents Document[]
  kycDocs   KycDocument[]

  @@unique([companyId, phone])
  @@index([companyId])
}

model Booking {
  id String @id @default(uuid())

  bookingNumber String?   // NEW

  companyId   String
  unitId      String @unique
  customerId  String
  projectId   String
  createdById String

  bookingDate DateTime @default(now())

  // NEW — broker / agent
  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  // NEW — booking money
  bookingAmount Float? 
  tokenAmount   Float?

  // Builder Side
  builtUpSqft    Float
  marketRate     Float
  builtUpValue   Float
  gstAmount      Float
  maintenanceFee Float
  advocateFee    Float
  mecbFee        Float
  oneTimeMaint   Float

  // Govt Side
  govtSqMeter     Float
  govtValue       Float
  stampDuty       Float
  registrationFee Float

  // Totals
  totalPrice Float
  govtAmount Float

  // NEW — split payment
  cashAmount Float
  bankAmount Float?    // NEW
  loanAmount Float?    // NEW

  // NEW — cancellation
  cancelDate      DateTime?
  refundAmount    Float?
  deductionAmount Float?

  status BookingStatus @default(BOOKED)

  // Relations
  unit     Unit     @relation(fields: [unitId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  createdBy User @relation("UserBookings", fields: [createdById], references: [id])

  payments Payment[]
  installments InstallmentPlan[]  // NEW
  documents Document[]
  commission BrokerCommission?
}

model Payment {
  id String @id @default(uuid())

  bookingId String
  companyId String

  amount Float
  stage  String

  installmentId String?
  installment InstallmentPlan? @relation(fields: [installmentId], references: [id])

  date    DateTime @default(now())
  mode    PaymentMode
  remarks String?

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  booking Booking @relation(fields: [bookingId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  cashbookEntry CashbookEntry?

  @@index([bankAccountId])
}

model ProjectBudget {
  id        String   @id @default(uuid())
  projectId String   @unique
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model InventoryInward {
  id         String   @id @default(uuid())
  projectId  String
  materialId String
  quantity   Float
  unitCost   Float?
  invoiceNo  String?
  remarks    String?
  vendorId   String?
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([vendorId])
}

model InventoryOutward {
  id         String   @id @default(uuid())
  projectId  String
  materialId String
  quantity   Float
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([projectId])
  @@index([materialId])
}

model InventoryRequirement {
  id           String   @id @default(uuid())
  projectId    String
  materialId   String
  requiredQty  Float
  fulfilledQty Float    @default(0)
  createdAt    DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([projectId])
}

model DailyReport {
  id        String   @id @default(uuid())
  projectId String
  date      DateTime

  workDetails String

  // Paper form fields
  siteName      String?
  meterFrom     Float?
  meterTo       Float?
  meterUnits    Float?
  checkedBy     String?

  project Project @relation(fields: [projectId], references: [id])

  labours   DailyLabour[]
  materials DailyMaterial[]
  payments  DailyPayment[]
  goods     DailyGoods[]

  createdAt DateTime @default(now())

  @@unique([projectId, date])
}

model DailyLabour {
  id String @id @default(uuid())

  reportId String
  agency   String

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  skilled Int
  men     Int
  women   Int
  total   Int

  report DailyReport @relation(fields: [reportId], references: [id])

  @@index([vendorId])
}

model DailyMaterial {
  id String @id @default(uuid())

  reportId String

  material   String // Cement / Steel / etc
  materialId String? // optional link to company Material master
  size       String? // 6mm, 8mm etc

  stock    Float
  consumed Float
  balance  Float

  report DailyReport @relation(fields: [reportId], references: [id])

  @@index([materialId])
}

model DailyPayment {
  id String @id @default(uuid())

  reportId String

  party    String
  amount   Float
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  report DailyReport @relation(fields: [reportId], references: [id])

  @@index([vendorId])
}

model DailyGoods {
  id String @id @default(uuid())

  reportId String

  material   String
  materialId String? // link to Material master for inventory inward
  quantity   Float
  remarks    String?
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])

  report DailyReport @relation(fields: [reportId], references: [id])

  @@index([materialId])
  @@index([vendorId])
}

model Task {
  id        String @id @default(uuid())
  projectId String

  title       String
  description String?

  status   String // Pending / InProgress / Done
  priority String // Low / Medium / High

  dueDate   DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Lead {
  id        String  @id @default(uuid())
  companyId String
  projectId String?
  unitId    String?
  campaignId String?

  name        String
  phone       String
  email       String?
  source      LeadSource @default(OTHER)
  sourceDetail     String? // campaign / listing title / notes
  portalListingId  String? // portal property/lead id
  portalUrl        String?
  referredBy       String? // for REFERRAL / BROKER name
  budget      Float?
  requirement String?

  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation("UserLeads", fields: [assignedToId], references: [id])

  nextFollowUp DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  project  Project?           @relation(fields: [projectId], references: [id])
  unit     Unit?              @relation(fields: [unitId], references: [id])
  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, source])
  @@index([companyId, status])
  @@index([campaignId])
}

enum LeadSource {
  PORTAL_99ACRES
  MAGICBRICKS
  HOUSING
  MAKAAN
  FACEBOOK
  INSTAGRAM
  GOOGLE_ADS
  WALK_IN
  REFERRAL
  BROKER
  WEBSITE
  WHATSAPP
  OTHER
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum InstallmentStatus {
  PENDING
  UPCOMING
  DUE
  OVERDUE
  PARTIAL
  PAID
  CANCELLED
}
model InstallmentPlan {
  id        String @id @default(uuid())
  bookingId String

  milestone String
  amount    Float
  dueDate   DateTime
  paid      Boolean @default(false)
    paidAmount Float @default(0)
  reminderSent Boolean @default(false)
  reminderSentAt DateTime?

  overdueNoticeSent Boolean @default(false)

  penaltyAmount Float? @default(0)

  status InstallmentStatus @default(PENDING)

  booking Booking @relation(fields:[bookingId], references:[id])

  payments Payment[]
}

model Document {
  id         String  @id @default(uuid())

  // Existing
  bookingId  String?
  customerId String?

  // Relations ✅ ADD THESE
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  // New scalable system
  entityType DocumentEntityType?
  entityId   String?
googleDriveFileId String?
  // Improvements
  name       String?
  type       String
  url        String

  uploadedAt DateTime @default(now())

  @@index([entityType, entityId])
}

enum DocumentEntityType {
  CUSTOMER
  BOOKING
  PROJECT
}

model BankAccount {
  id             String           @id @default(uuid())
  companyId      String
  name           String
  accountType    BankAccountType  @default(BANK)
  bankName       String?
  accountNumber  String?
  ifsc           String?
  openingBalance Float            @default(0)
  balance        Float            @default(0)
  isDefault      Boolean          @default(false)
  isActive       Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company         Company         @relation(fields: [companyId], references: [id])
  cashbookEntries CashbookEntry[]
  payments        Payment[]
  expenses        Expense[]
  landPayments    LandParcelPayment[]

  @@index([companyId])
}

enum BankAccountType {
  BANK
  CASH
  UPI
  OTHER
}

enum CashbookEntryType {
  CREDIT
  DEBIT
}

enum CashbookCategory {
  OPENING
  BOOKING_RECEIPT
  EXPENSE
  VENDOR_PAYMENT
  BROKER_COMMISSION
  LAND_PURCHASE
  JV_PAYOUT
  TRANSFER
  ADJUSTMENT
  OTHER
}

model CashbookEntry {
  id            String            @id @default(uuid())
  companyId     String
  bankAccountId String
  type          CashbookEntryType
  category      CashbookCategory  @default(OTHER)
  amount        Float
  balanceAfter  Float
  date          DateTime          @default(now())
  description   String?
  reference     String? // cheque / UTR / voucher no
  projectId     String?
  paymentId     String?           @unique
  expenseId     String?           @unique
  transferGroupId String? // pairs transfer in/out
  createdAt     DateTime          @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  project     Project?    @relation(fields: [projectId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])
  expense     Expense?    @relation(fields: [expenseId], references: [id])

  @@index([companyId, date])
  @@index([bankAccountId, date])
  @@index([transferGroupId])
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model Broker {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  phone          String
  email          String?
  panNumber      String?
  address        String?
  commissionRate Float // percent, e.g. 2.5
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company     Company            @relation(fields: [companyId], references: [id])
  bookings    Booking[]
  commissions BrokerCommission[]

  @@index([companyId])
}

model BrokerCommission {
  id               String           @id @default(uuid())
  companyId        String
  brokerId         String
  bookingId        String           @unique
  rate             Float // snapshot % at booking time
  dealAmount       Float
  commissionAmount Float
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  paidAmount       Float?
  notes            String?
  createdAt        DateTime         @default(now())

  broker  Broker  @relation(fields: [brokerId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([companyId])
  @@index([brokerId])
  @@index([status])
}

model KycDocument {
  id          String   @id @default(uuid())
  customerId  String

  type        KycType
  number      String?
  fileUrl     String

  verified    Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  googleDriveFileId String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum KycType {
  PAN
  AADHAR
  PASSPORT
  DRIVING_LICENSE
}

// ================= LAND ACQUISITION (Easy Colonizer–style)
enum LandAcquisitionType {
  OUTRIGHT
  JV
  DEVELOPMENT_AGREEMENT
  OTHER
}

enum LandParcelStatus {
  PROSPECT
  UNDER_NEGOTIATION
  AGREED
  REGISTERED
  LINKED_TO_PROJECT
  CANCELLED
}

enum LandPartnerRole {
  LANDOWNER
  INVESTOR
  DEVELOPER
  OTHER
}

model LandPartner {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  phone        String?
  email        String?
  panNumber    String?
  aadharNumber String?
  address      String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company  Company             @relation(fields: [companyId], references: [id])
  shares   LandParcelPartner[]
  payments LandParcelPayment[]

  @@index([companyId])
}

model LandParcel {
  id               String              @id @default(uuid())
  companyId        String
  projectId        String?
  name             String
  surveyNumber     String?
  gatNumber        String?
  village          String?
  taluka           String?
  district         String?
  areaSqFt         Float?
  areaAcres        Float?
  acquisitionType  LandAcquisitionType @default(OUTRIGHT)
  status           LandParcelStatus    @default(PROSPECT)
  purchasePrice    Float?
  agreementDate    DateTime?
  registrationDate DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company  Company             @relation(fields: [companyId], references: [id])
  project  Project?            @relation(fields: [projectId], references: [id])
  partners LandParcelPartner[]
  payments LandParcelPayment[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model LandParcelPartner {
  id            String          @id @default(uuid())
  landParcelId  String
  partnerId     String
  role          LandPartnerRole @default(LANDOWNER)
  sharePercent  Float?
  landShareSqFt Float?
  notes         String?

  parcel  LandParcel  @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  partner LandPartner @relation(fields: [partnerId], references: [id])

  @@unique([landParcelId, partnerId])
  @@index([partnerId])
}

model LandParcelPayment {
  id            String   @id @default(uuid())
  companyId     String
  landParcelId  String
  partnerId     String?
  amount        Float
  date          DateTime @default(now())
  description   String?
  reference     String?
  bankAccountId String?
  createdAt     DateTime @default(now())

  parcel      LandParcel   @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  partner     LandPartner? @relation(fields: [partnerId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([companyId])
  @@index([landParcelId])
  @@index([partnerId])
  @@index([bankAccountId])
}

// ================= REMINDERS / FOLLOW-UPS
enum ReminderType {
  LEAD_FOLLOW_UP
  INSTALLMENT_DUE
  INSTALLMENT_OVERDUE
  MANUAL
}

enum ReminderChannel {
  WHATSAPP
  SMS
  IN_APP
  MANUAL
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  SKIPPED
  CANCELLED
}

model Reminder {
  id          String          @id @default(uuid())
  companyId   String
  type        ReminderType
  channel     ReminderChannel @default(IN_APP)
  status      ReminderStatus  @default(PENDING)
  entityType  String // Lead | InstallmentPlan | Manual
  entityId    String?
  title       String
  message     String?
  phone       String?
  dueAt       DateTime
  sentAt      DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status, dueAt])
  @@index([companyId, type])
  @@index([entityType, entityId])
}

// ================= MARKETING CAMPAIGNS (compose & share)
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignShareChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
}

model MarketingCampaign {
  id        String         @id @default(uuid())
  companyId String
  code      String         @unique
  title     String
  status    CampaignStatus @default(DRAFT)

  projectId String
  unitId    String?

  headline  String
  body      String
  ctaLabel  String  @default("Enquire now")
  ctaPhone  String?
  imageUrl  String?

  enableWhatsapp  Boolean @default(true)
  enableFacebook  Boolean @default(true)
  enableInstagram Boolean @default(true)

  shareCount        Int @default(0)
  landingViewCount  Int @default(0)
  leadCount         Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  project   Project              @relation(fields: [projectId], references: [id])
  unit      Unit?                @relation(fields: [unitId], references: [id])
  createdBy User?                @relation("UserCampaigns", fields: [createdById], references: [id])
  shares    CampaignShareEvent[]
  leads     Lead[]

  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([code])
}

model CampaignShareEvent {
  id         String               @id @default(uuid())
  campaignId String
  channel    CampaignShareChannel
  createdAt  DateTime             @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, channel])
}

